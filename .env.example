# Copy to .env and fill in real values:  cp .env.example .env
#
# There is no settings file — the application reads its configuration from the
# environment, unprefixed. .env is loaded for local development; in a container
# these are supplied as `environment:` entries or a Kubernetes ConfigMap/Secret.
#
# Each package owns its own config class (baymax/<package>/config.py) and
# baymax/config.py composes them. Everything has a default in code except the
# five marked REQUIRED — those fail fast at startup if unset.

# --- Hugging Face ---
# Needed to pull gated models (e.g. google/medgemma-4b-it).
# Create at https://huggingface.co/settings/tokens and accept the model's terms
# on its model page, otherwise vLLM fails with "gated repo" / 401.
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres container (read by the postgres image's entrypoint) ---
POSTGRES_USER=baymax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baymax

# --- Redis container ---
REDIS_PASSWORD=change-me

# --- Database (baymax/db/config.py) ---
# REQUIRED. A bare postgresql:// scheme is upgraded to postgresql+psycopg://
# automatically, so the same URL works for psql, Alembic and the app.
# Holds both the knowledge base and the chat tables.
DATABASE_URL=postgresql+psycopg://baymax:change-me@localhost:5432/baymax
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# --- Celery (baymax/celery/config.py) ---
# REQUIRED. CELERY_RESULT_BACKEND defaults to the broker when unset.
CELERY_BROKER_URL=redis://:change-me@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@localhost:6379/1
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_BACKOFF=5
CELERY_TASK_RETRY_BACKOFF_MAX=300
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600

# --- Embedding client (baymax/clients/config.py) ---
# REQUIRED (base url + model). vLLM serving bge-m3 over its OpenAI-compatible API.
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=not-needed
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=32
# Vector width the model emits; collections are created to match, and a
# mismatch is rejected with a clear error. bge-m3 = 1024.
EMBEDDING_DIMENSIONS=1024

# --- Generative model (baymax/clients/config.py) ---
# vLLM serving MedGemma. Used by the chat agent for both the guardrail and the
# answer; the guardrail overrides temperature and max_tokens internally.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=medgemma-4b
LLM_API_KEY=not-needed
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- Qdrant client (baymax/clients/config.py) ---
# REQUIRED (url). Leave the key empty unless QDRANT__SERVICE__API_KEY is set on
# the server in vector-store/qdrant/qdrant.yml.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false
QDRANT_DISTANCE=Cosine

# --- Knowledge base (baymax/knowledge_base/config.py) ---
KNOWLEDGE_BASE_COLLECTION=baymax_v1
KNOWLEDGE_BASE_MAX_QUESTIONS_PER_ENTRY=256
# Changing this re-points every future pair; existing points are unaffected.
KNOWLEDGE_BASE_POINT_NAMESPACE=6f8b6d1c-0d3a-4b2e-9b8a-1c2d3e4f5a6b

# --- Chat (baymax/chat/config.py) ---
# Documents pulled from Qdrant, and earlier user questions replayed, per turn.
CHAT_RETRIEVAL_TOP_K=5
CHAT_HISTORY_TURNS=5

# --- External medical tools (baymax/chat/config.py) ---
# Authoritative service endpoints.
MEDLINEPLUS_SEARCH_URL=https://wsearch.nlm.nih.gov/ws/query
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_EVENT_URL=https://api.fda.gov/drug/event.json

# Compact response and process-local cache limits.
MEDICAL_TOOLS_MAX_RESULTS=5
MEDICAL_TOOLS_MAX_SUMMARY_CHARS=1600
MEDICAL_TOOLS_MAX_LABEL_SECTION_CHARS=1800
MEDICAL_TOOLS_MAX_CACHE_ENTRIES=512

# Dynaconf JSON list. Only these HTTP statuses receive bounded retries.
MEDICAL_TOOLS_TRANSIENT_STATUS_CODES='@json [408, 425, 429, 500, 502, 503, 504]'
MEDICAL_TOOLS_HTTP_CONNECT_TIMEOUT=5
MEDICAL_TOOLS_HTTP_READ_TIMEOUT=15
MEDICAL_TOOLS_HTTP_WRITE_TIMEOUT=5
MEDICAL_TOOLS_HTTP_POOL_TIMEOUT=5
MEDICAL_TOOLS_HTTP_MAX_RETRIES=2
MEDICAL_TOOLS_HTTP_RETRY_MULTIPLIER=0.25
MEDICAL_TOOLS_HTTP_RETRY_MIN_WAIT=0.25
MEDICAL_TOOLS_HTTP_RETRY_MAX_WAIT=2

# Included in every openFDA/FAERS response.
FAERS_DISCLAIMER="FAERS reports do not establish that the drug caused the reported event. Counts are reports, not incidence rates or probabilities."

# The assistant's persona, interpolated into CHAT_ANSWER_SYSTEM_PROMPT.
CHAT_SYSTEM_PROMPT="You are Baymax, a careful medical assistant. Answer clearly and concisely. Recommend seeing a clinician for anything urgent, and never invent facts you are not sure of."

# Sent verbatim when the guardrail rejects a question. Never generated, so it
# cannot be steered by the input.
CHAT_BLOCKED_MESSAGE="I can not process this request. I can only answer questions about medical topics, health conditions, and medications."

# Stand-ins when retrieval finds nothing / on the first turn of a conversation.
CHAT_NO_DOCUMENTS_TEXT="(nothing relevant found in the knowledge base)"
CHAT_NO_HISTORY_TEXT="(this is the user's first question in this conversation)"

# The remaining prompts are long and multi-line; their defaults are the _DEFAULT_*
# constants at the top of baymax/chat/config.py. Override them through a
# ConfigMap or an exported variable rather than here. Each is rendered with
# str.format and must keep its placeholders:
#
#   CHAT_GUARDRAIL_SYSTEM_PROMPT   (no placeholders)
#   CHAT_GUARDRAIL_USER_TEMPLATE   {question}
#   CHAT_ANSWER_SYSTEM_PROMPT      {system_prompt}
#   CHAT_ANSWER_USER_TEMPLATE      {documents} {history} {question}
#
# CHAT_GUARDRAIL_SYSTEM_PROMPT must keep telling the model to answer with a
# single 1 or 0 — anything else is read as 0, which blocks every question.

# --- API (baymax/api/config.py) ---
API_TITLE=Baymax API
API_VERSION=0.1.0
API_ROOT_PATH=
# API_DESCRIPTION=

# Swagger UI, ReDoc and the raw schema. Worth disabling in production: the
# schema documents every field and error of an internal service.
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# --- Logging (baymax/config.py) ---
# DEBUG adds per-batch embedding and per-query repository lines.
LOG_LEVEL=INFO
# Loguru format. correlation_id and component are populated for application and
# intercepted third-party records.
# LOG_FORMAT="{time:YYYY-MM-DDTHH:mm:ss.SSSZ} | {level:<8} | [{extra[correlation_id]}] | {extra[component]} | {message}"
# Override the per-library levels wholesale, e.g. @json {"httpx": "DEBUG"}
# LOG_LIBRARY_LEVELS=

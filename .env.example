# Copy to .env and fill in real values:  cp .env.example .env

# --- Hugging Face ---
# Needed to pull gated models (e.g. google/medgemma-4b-it).
# Create at https://huggingface.co/settings/tokens and accept the model's terms
# on its model page, otherwise vLLM fails with "gated repo" / 401.
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres ---
POSTGRES_USER=baymax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baymax
DATABASE_URL=postgresql://baymax:change-me@localhost:5432/baymax

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Qdrant ---
# Only needed if you uncomment QDRANT__SERVICE__API_KEY in vector-store/qdrant/qdrant.yml
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Copy to .env:  cp .env.example .env
#
# Arize Phoenix — https://github.com/Arize-ai/phoenix
#
# Baymax uses it as the store of record for every prompt hiro sends. hiro ships
# no prompt text of its own, so this must be up and seeded before the chat API
# can answer anything: see ../hiro/scripts/seed_prompts.py.

# --- server ---
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- auth ---
# Off by default, which is fine for a local bind and not for an exposed host.
# Set both to true/secret to require login and API keys; hiro then needs
# PHOENIX_API_KEY in hiro/.env.
PHOENIX_ENABLE_AUTH=false
# PHOENIX_SECRET=

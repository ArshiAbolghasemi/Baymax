# Copy to .env:  cp .env.example .env
#
# Arize Phoenix — https://github.com/Arize-ai/phoenix
#
# Baymax uses it as the store of record for every prompt hiro sends. hiro ships
# no prompt text of its own, so this must be up and seeded before the chat API
# can answer anything: see ../hiro/scripts/seed_prompts.py.

# --- server ---
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- auth ---
# Off by default, which is fine for a local bind and not for an exposed host.
# Set both to true/secret to require login and API keys; hiro then needs
# PHOENIX_API_KEY in hiro/.env.
PHOENIX_ENABLE_AUTH=false
# PHOENIX_SECRET=

# --- playground target ---
# Points Phoenix's OpenAI provider at hiro's own chat API instead of api.openai.com,
# so running a prompt in the playground exercises the whole agent — guardrail,
# retrieval, MCP tools — not the raw model. host.docker.internal is how the
# container reaches hiro on the host; use http://localhost:8080/v1 only if you
# run Phoenix outside Docker.
#
# The model to type in the playground is baymax, the id hiro advertises at
# GET /v1/models. Leave OPENAI_API_KEY unset: with a base url and no key,
# Phoenix sends a placeholder, and hiro does not check it. Setting a real
# OPENAI_API_KEY here would make Phoenix refuse a per-request custom base url.
OPENAI_BASE_URL=http://host.docker.internal:8080/v1

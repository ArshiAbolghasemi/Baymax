# --- general -----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FILE_PATH=./access.log

# --- mcp server --------------------------------------------------------------
SERVER_NAME=dobby
SERVER_VERSION=0.1.0
MCP_HTTP_ADDR=:8080
MCP_HTTP_ENDPOINT=/mcp
MCP_HTTP_STATELESS=true
METRICS_ADDR=:2112
SHUTDOWN_TIMEOUT=30s
# Comma-separated subset of the tools to expose, in order. Empty exposes all of
# search_health_info,search_drug_label,search_drug_safety,search_genetics
ENABLED_TOOLS=

# --- authoritative sources ---------------------------------------------------
# These names are the ones hiro's Python configuration already reads, so one
# .env configures both processes and they cannot drift apart. None of these
# APIs needs a key.
MEDLINEPLUS_SEARCH_URL=https://wsearch.nlm.nih.gov/ws/query
MEDLINEPLUS_GENETICS_URL=https://medlineplus.gov/download/genetics
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_EVENT_URL=https://api.fda.gov/drug/event.json
# The NLM search service asks automated clients to identify themselves.
MEDICAL_TOOLS_SEARCH_IDENTIFIER=baymax

# --- response budgets --------------------------------------------------------
# Hard caps applied after retrieval, so a verbose source cannot blow up a
# client's context window.
MEDICAL_TOOLS_MAX_RESULTS=5
MEDICAL_TOOLS_MAX_SUMMARY_CHARS=1600
MEDICAL_TOOLS_MAX_LABEL_SECTION_CHARS=1800
MEDICAL_TOOLS_MAX_CACHE_ENTRIES=512

# --- outbound http -----------------------------------------------------------
MEDICAL_TOOLS_HTTP_TIMEOUT=15s
# Retries after the first attempt, so 2 means at most 3 attempts.
MEDICAL_TOOLS_HTTP_MAX_RETRIES=2
MEDICAL_TOOLS_HTTP_RETRY_MULTIPLIER=250ms
MEDICAL_TOOLS_HTTP_RETRY_MAX_WAIT=2s
# Only these statuses are retried. 404 is deliberately absent: openFDA answers
# it for a search with no matching reports, which is an answer, not a failure.
MEDICAL_TOOLS_TRANSIENT_STATUS_CODES=408,425,429,500,502,503,504

# --- cache lifetimes ---------------------------------------------------------
# DailyMed publishes label revisions continuously and FAERS refreshes daily, so
# their answers age faster than the editorial MedlinePlus content.
MEDICAL_TOOLS_HEALTH_INFO_TTL=15m
MEDICAL_TOOLS_GENETICS_TTL=15m
MEDICAL_TOOLS_DRUG_LABEL_TTL=5m
MEDICAL_TOOLS_DRUG_SAFETY_TTL=2m

# --- disclaimers -------------------------------------------------------------
FAERS_DISCLAIMER=FAERS reports do not establish that the drug caused the reported event. Counts are reports, not incidence rates or probabilities.

# Copy to .env:  cp .env.example .env
#
# bashmax is a pure client: it needs the address of a running hiro API and
# nothing else. No database, no broker, no model credentials.

# --- hiro API ---
# Base url including the /v1 prefix.
BAYMAX_URL=http://localhost:8080/v1

# Model name to request. hiro advertises one at GET /v1/models.
BAYMAX_MODEL=baymax

# Sent as a bearer token. hiro does not check it today.
BAYMAX_API_KEY=not-needed

# Copy to .env:  cp .env.example .env
#
# eve is a pure client: it needs a running hiro API and nothing else.

# hiro's base url, including the /v1 prefix.
VITE_HIRO_URL=http://localhost:8080/v1

# The only model hiro serves; it refuses any other with 404.
VITE_HIRO_MODEL=baymax

# Sent as a bearer token. hiro does not check it today.
VITE_HIRO_API_KEY=not-needed

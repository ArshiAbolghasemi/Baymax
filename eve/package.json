{
  "name": "eve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chat UI for the hiro agent, with its tool calls rendered as they happen",
  "scripts": {
    "dev": "vite",
    "build": "biome check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "check": "node src/check.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}

# Copy to .env:  cp .env.example .env
#
# Credentials for the containers defined in this directory. The compose
# files read this file directly; hiro/.env must use the same values in its
# DATABASE_URL and CELERY_BROKER_URL.

# --- Hugging Face ---
# Needed to pull gated models (e.g. google/medgemma-4b-it).
# Create at https://huggingface.co/settings/tokens and accept the model's terms
# on its model page, otherwise vLLM fails with "gated repo" / 401.
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres container (read by the postgres image's entrypoint) ---
POSTGRES_USER=baymax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baymax

# --- Redis container ---
REDIS_PASSWORD=change-me
